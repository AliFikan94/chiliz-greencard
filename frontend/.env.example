# Django backend
NEXT_PUBLIC_LEARNING_API_BASE=http://127.0.0.1:8000/api/learning
NEXT_PUBLIC_REWARD_API_BASE=http://127.0.0.1:8000/api/reward

# Chiliz Chain RPCs (only needed if you want to override the public defaults)
NEXT_PUBLIC_SPICY_RPC_URL=https://spicy-rpc.chiliz.com
NEXT_PUBLIC_CHILIZ_RPC_URL=https://rpc.ankr.com/chiliz

# Free project ID from https://cloud.reown.com - required to offer
# WalletConnect (Socios Wallet, and other mobile wallets) as a connect
# option. Without it, only browser-extension wallets (MetaMask) show up.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
