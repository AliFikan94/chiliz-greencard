# Wallet used to deploy the contracts (needs testnet CHZ from the Spicy faucet)
DEPLOYER_PRIVATE_KEY=

# Address the Django backend signs reward vouchers with (see reward/services.py).
# Its private key lives only in the backend's env (REWARD_SIGNER_PRIVATE_KEY),
# never here.
BACKEND_SIGNER_ADDRESS=

# Optional: owner/admin address for the deployed contracts if it should differ
# from the deployer (defaults to the deployer address).
CONTRACT_ADMIN_ADDRESS=

# Optional: override default public RPC endpoints
SPICY_RPC_URL=https://spicy-rpc.chiliz.com
CHILIZ_RPC_URL=https://rpc.ankr.com/chiliz
