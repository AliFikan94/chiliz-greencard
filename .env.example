# Onchain rewards (see contracts/ for the deployed contracts)

# Private key of the wallet that signs EIP-712 reward vouchers. This wallet
# never holds funds - it only authorizes claims users submit themselves.
REWARD_SIGNER_PRIVATE_KEY=

# RewardDistributor contract address from `contracts/scripts/deploy.js`.
REWARD_DISTRIBUTOR_ADDRESS=

# 88882 = Chiliz Spicy testnet, 88888 = Chiliz mainnet.
CHILIZ_CHAIN_ID=88882

# How long an issued voucher stays claimable, in seconds.
REWARD_VOUCHER_TTL_SECONDS=900
