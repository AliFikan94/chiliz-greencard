# Onchain rewards (see contracts/ for the deployed contracts)

# Private key of the wallet that signs EIP-712 reward vouchers. This wallet
# never holds funds - it only authorizes claims users submit themselves.
REWARD_SIGNER_PRIVATE_KEY=

# RewardDistributor contract address from `contracts/scripts/deploy.js`.
REWARD_DISTRIBUTOR_ADDRESS=

# 88882 = Chiliz Spicy testnet, 88888 = Chiliz mainnet.
CHILIZ_CHAIN_ID=88882

# How long an issued voucher stays claimable, in seconds.
REWARD_VOUCHER_TTL_SECONDS=900


# Production deployment (e.g. Railway) - leave unset for local dev, which
# falls back to DEBUG=True and SQLite.

# A long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`.
SECRET_KEY=

DEBUG=False

# Comma-separated. e.g. your-app.up.railway.app
ALLOWED_HOSTS=

# Comma-separated, must include the scheme. e.g. https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Comma-separated frontend origin(s). *.vercel.app is always allowed already.
CORS_ALLOWED_ORIGINS=

# Provided automatically by Railway's Postgres plugin - falls back to
# SQLite when unset.
DATABASE_URL=
